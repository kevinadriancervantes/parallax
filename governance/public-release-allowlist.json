{
  "schema_version": "parallax.public-release.allowlist.v1",
  "release_id": "PARALLAX_PUBLIC_RELEASE_CANDIDATE_V1",
  "rule": "The physical public tree is exactly the union of PUBLIC and PUBLIC_SANITIZED paths, including the release manifest and seal.",
  "PUBLIC": [
    "README.md",
    "contest-narrative.md",
    "executive-summary.md",
    "figures/figure-plan.md",
    "index.html",
    "governance/accepted-lineage.json",
    "governance/claim-audit.json",
    "governance/claim-evidence-matrix.csv",
    "governance/claim-firewall-review.md",
    "governance/contradiction-audit.json",
    "governance/failure-semantics.md",
    "governance/public-artifact-inventory.json",
    "governance/public-release-allowlist.json",
    "governance/release-privacy-receipt.json",
    "governance/sources.md",
    "microsite/index.md",
    "parallax-public-release-manifest.json",
    "parallax-public-release-seal.json",
    "predecessor/contest-package-manifest.json",
    "predecessor/contest-package-seal.json",
    "reproducibility/README.md",
    "reproducibility/seal_public_release.py",
    "reproducibility/verify_public_release.py",
    "submission/abstract-150.md",
    "submission/evaluation-title.txt",
    "submission/form-draft.md",
    "submission/github-checklist.md",
    "submission/microsite-checklist.md"
  ],
  "PUBLIC_SANITIZED": [
    "evidence/confirmatory-reference-summary.json",
    "evidence/local-surrogate-summary.json",
    "evidence/provider-cost-correction.json",
    "evidence/provider-qualification-summary.json",
    "evidence/synthetic-shadow-summary.json",
    "governance/hardening-public-artifact-inventory.json",
    "governance/hardening-substrate-inventory.json",
    "governance/privacy-audit.json",
    "governance/semantic-diff.json",
    "hardening-accounting-reproduction.json",
    "hardening-report.md",
    "local-review/local-review-normalized.json"
  ],
  "LOCAL_PRIVATE_EXCLUDED": [
    "local-review/local-review-run.json",
    "local-review/raw/*.json",
    "raw provider qualification envelopes",
    "raw local scientific response rows",
    "development-only build and hardening scripts",
    "repository research source trees"
  ],
  "SECRET_NEVER_EXPORT": [
    "credential values",
    "authorization headers",
    "private account identifiers",
    "personal absolute paths and usernames",
    "MAC, serial, process, and unrelated machine identifiers",
    "non-loopback network addresses",
    "raw provider or local-model bodies"
  ],
  "status": "PASS"
}
